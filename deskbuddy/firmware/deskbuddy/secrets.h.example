#pragma once
// Copy to secrets.h (in this same folder, next to deskbuddy.ino):
//   cp secrets.h.example secrets.h
// secrets.h is gitignored — never commit real Wi-Fi credentials.

// Wi-Fi the ESP32 joins (must be the same LAN as the phone broker)
#define WIFI_SSID   "your-ssid"
#define WIFI_PASS   "your-password"

// The phone's LAN IP running deskbuddy/broker.py (inside proot), and its port
#define BROKER_HOST "192.168.29.xxx"
#define BROKER_PORT 2125

// Mic gain is not a secret and lives in deskbuddy.ino as MIC_GAIN_SHIFT.
