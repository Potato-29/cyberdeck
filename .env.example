# Copy to .env and fill in real values: cp .env.example .env

# ntfy (HTTP basic)
NTFY_URL=https://ntfy.example.com
NTFY_TOPIC=your-topic
NTFY_USER=your-ntfy-user
NTFY_PASS=your-ntfy-password

# Webhook / restart service (query token)
WEBHOOK_TOKEN=generate-a-long-random-secret
RESTART_URL=https://restart.example.com

# PC (LibreHardwareMonitor / wtfutil telemetry)
PC_IP=192.168.x.x
PC_TELEMETRY_PORT=8085

# PC deck agent (app launcher) — needed by both webhook_new.py and pc-deck-agent.py
PC_AGENT_PORT=8086
PC_AGENT_TOKEN=generate-a-long-random-secret

# Weekly standup logger
# Where the append-only log lives on the deck
STANDUP_FILE=~/standup-log.jsonl
# Optional — without a key the Friday draft is assembled from your raw notes.
# Free key from https://console.groq.com/keys
GROQ_API_KEY=
# Check https://console.groq.com/docs/models — Groq retires model IDs periodically
STANDUP_MODEL=llama-3.3-70b-versatile
# Optional — your company values, so section 4 can name a real one
STANDUP_VALUES=

# Idea board (ideas.prayas.space) — standalone service, own accounts, own DB.
# Does NOT use WEBHOOK_TOKEN.
IDEAS_PORT=2124
# Kept outside the repo: this file holds other users' password hashes.
IDEAS_DB=~/ideas.db
# Signs session cookies. Changing it signs everyone out. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
IDEAS_SESSION_SECRET=generate-a-long-random-secret
# open | invite | closed — flip to invite/closed if registration gets abused
IDEAS_SIGNUP_MODE=open

# ESP32
ESP32_IP=192.168.x.x
# Token used in status_checker for GET /status on the device
ESP32_STATUS_TOKEN=your-esp32-status-token
# Token appended to ESP32 requests from webhook_new.py
ESP32_API_TOKEN=your-esp32-api-token

# Desk buddy (voice assistant) — standalone aiohttp broker in proot on the phone.
# Reuses GROQ_API_KEY above. LAN-only, no token. See docs/deskbuddy.md.
BUDDY_PORT=2125
# Model IDs overridable — Groq retires them (same rationale as STANDUP_MODEL)
BUDDY_STT_MODEL=whisper-large-v3-turbo
BUDDY_LLM_MODEL=llama-3.3-70b-versatile
# Groq TTS is preview; swap model/voice if it changes
BUDDY_TTS_MODEL=playai-tts
BUDDY_TTS_VOICE=Fritz-PlayAI
# openWakeWord pretrained model + trigger threshold (0..1; raise to cut false wakes)
BUDDY_WAKE_MODEL=hey_jarvis
BUDDY_WAKE_THRESHOLD=0.5
# Persona for the LLM (keep replies short for snappy TTS)
BUDDY_SYSTEM_PROMPT=You are a terse, witty desk assistant. Answer in 1-3 sentences.
