# Copy to .env and fill in real values: cp .env.example .env

# ntfy (HTTP basic)
NTFY_URL=https://ntfy.example.com
NTFY_TOPIC=your-topic
NTFY_USER=your-ntfy-user
NTFY_PASS=your-ntfy-password

# Webhook / restart service (query token)
WEBHOOK_TOKEN=generate-a-long-random-secret
RESTART_URL=https://restart.example.com

# PC (LibreHardwareMonitor / wtfutil telemetry)
PC_IP=192.168.x.x
PC_TELEMETRY_PORT=8085

# PC deck agent (app launcher) — needed by both webhook_new.py and pc-deck-agent.py
PC_AGENT_PORT=8086
PC_AGENT_TOKEN=generate-a-long-random-secret

# Weekly standup logger
# Where the append-only log lives on the deck
STANDUP_FILE=~/standup-log.jsonl
# Optional — without a key the Friday draft is assembled from your raw notes.
# Free key from https://console.groq.com/keys
GROQ_API_KEY=
# Check https://console.groq.com/docs/models — Groq retires model IDs periodically
STANDUP_MODEL=llama-3.3-70b-versatile
# Optional — your company values, so section 4 can name a real one
STANDUP_VALUES=

# ESP32
ESP32_IP=192.168.x.x
# Token used in status_checker for GET /status on the device
ESP32_STATUS_TOKEN=your-esp32-status-token
# Token appended to ESP32 requests from webhook_new.py
ESP32_API_TOKEN=your-esp32-api-token
